# ── cre-command .dockerignore ────────────────────────────────────────────────
# Images compile from source: build context carries workspace manifests and
# src/ trees only. Never ship local state, secrets, or audit artifacts.

# Dependency trees — regenerated by npm ci inside the build
node_modules
**/node_modules

# Build outputs — regenerated inside the image
.next
**/.next
dist
**/dist

# Git & VCS
.git
.gitignore
.gitattributes

# Local env & secrets — images must never bake configuration in
.env
.env.*
!.env.example
TEST_ENCRYPTION_KEY.txt
*.pem
*.key

# Tests & coverage (TS runs from source via tsx; nothing here is needed at runtime)
coverage
**/coverage
**/test
**/tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
vitest.*.config.ts

# Logs, scratch output, audit artifacts
*.log
t*.log
api-*.txt
test-results.txt
full-test-results.txt
packages/api/test-output.txt
AUDIT_REPORT*

# Docs & local helper scripts
docs/
*.bat
*.cmd
*.ps1
run-tests*
start-api*

# Docker & CI — not needed inside the images
Dockerfile*
docker-compose*.yml
compose*.yml
.dockerignore
.github/
