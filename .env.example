# ── cre-command production environment template ─────────────────────────────
NODE_ENV=production

# API
PORT=4000
APP_ORIGIN=https://app.example.com

# Sessions. Use a long random secret (openssl rand -hex 32).
SESSION_SECRET=replace-me-with-64-hex-chars
SESSION_TTL_HOURS=24
SECURE_COOKIES=true

# Storage
STORE_MODE=postgres
# DATABASE_URL=postgres://cre:secret@db:5432/cre_command

# Crawler engine
CRAWLER_INLINE=false            # scale-out mode: run packages/workers separately
CRAWLER_MAX_WORKERS=8
CRAWLER_DEFER_NEXT_MS=500
CRAWLER_MAX_RETRIES=3
CRAWLER_REQUEST_TIMEOUT_MS=20000
ROBOTS_STRICT=true
CRAWLER_USER_AGENT=cre-command/1.0 (production; ops@example.com)

# Bootstrap
DEMO_SEED=false

# CSV export
EXPORT_MAX_SYNC_ROWS=10000