# ── cre-command production environment template ──────────────────────────────

NODE_ENV=production

# API server
PORT=4000
HOST=0.0.0.0

# Database (required by @cre/db)
DATABASE_URL=postgres://cre:CHANGE-ME@db:5432/cre_command

# Security ─ CORS allowlist: exact browser origins that may call the API.
# Empty = same-origin only (correct when Next proxies /api). Never use '*'.
CORS_ORIGINS=https://app.example.com

# Security ─ rate limiting (sliding window per client IP)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10

# Security ─ request handling
BODY_LIMIT_BYTES=1048576
# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=true

# Observability
LOG_LEVEL=info

# Bootstrap admin — honored ONLY while the users table is empty. Set both or
# neither. Remove from the environment once operator accounts exist.
# CRE_ADMIN_EMAIL=ops@example.com
# CRE_ADMIN_PASSWORD=use-a-password-manager

# Sessions (opaque bearer tokens; TTL bounded 1h…2160h = 90d)
CRE_SESSION_TTL_HOURS=168
# Prune expired session rows hourly; 0 disables the in-process timer
SESSION_PRUNE_INTERVAL_MS=3600000